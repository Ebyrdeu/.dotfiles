#!/usr/bin/env bash
set -euo pipefail

# Colors
C_RESET='\033[0m'
C_OK='\033[0;32m'
C_WARN='\033[1;33m'
C_ERR='\033[0;31m'
C_HEAD='\033[1;36m'

# Helpers
say()  { printf "%b[INFO]%b %s\n" "$C_HEAD" "$C_RESET" "$*"; }
ok()   { printf "%b[OK]%b %s\n" "$C_OK"   "$C_RESET" "$*"; }
warn() { printf "%b[WARN]%b %s\n" "$C_WARN" "$C_RESET" "$*"; }
err()  { printf "%b[ERR]%b %s\n" "$C_ERR"  "$C_RESET" "$*" >&2; }

# Usage check
if [[ -z "${1:-}" ]]; then
    echo "Usage: $(basename "$0") <directory_path>"
    exit 1
fi

# Input Processing
INPUT_PATH="${1%/}"
DIR_NAME=$(basename "$INPUT_PATH")
PARENT_DIR=$(dirname "$INPUT_PATH")
OUTPUT_FILE="${PWD}/${DIR_NAME}.tar.gz"

if [[ ! -d "$INPUT_PATH" ]]; then
    err "Directory '$INPUT_PATH' does not exist."
    exit 1
fi

# Overwrite Confirmation
if [[ -f "$OUTPUT_FILE" ]]; then
    warn "File '$OUTPUT_FILE' already exists."
    read -rp "Overwrite? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        exit 0
    fi
fi

# Auto-detect pigz (multi-threaded gzip)
COMPRESSOR="gzip"
if command -v pigz >/dev/null 2>&1; then
    COMPRESSOR="pigz"
fi

# Cleanup partial output on failure or interruption
cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 && -f "$OUTPUT_FILE" ]]; then
        echo
        warn "Process interrupted or failed. Cleaning up partial archive..."
        rm -f "$OUTPUT_FILE"
    fi
    exit $exit_code
}
trap cleanup EXIT SIGINT SIGTERM

# ============================================================
# Execution
# ============================================================

say "Archiving: $DIR_NAME"
say "Method:    tar + $COMPRESSOR"
echo "------------------------------------------------------------"

RAW_SIZE=$(du -sb "$INPUT_PATH" 2>/dev/null | cut -f1 || echo 0)

if command -v pv >/dev/null 2>&1 && [[ "$RAW_SIZE" -gt 0 ]]; then
    tar -C "$PARENT_DIR" -cf - "$DIR_NAME" \
        | pv -s "$RAW_SIZE" -N "Compressing" \
        | $COMPRESSOR > "$OUTPUT_FILE"
else
    tar -C "$PARENT_DIR" -cf - "$DIR_NAME" \
        | $COMPRESSOR > "$OUTPUT_FILE"
fi

# ============================================================
# Summary
# ============================================================

if [[ -f "$OUTPUT_FILE" ]]; then
    echo "------------------------------------------------------------"

    SIZE_ORIG=$(du -sh "$INPUT_PATH" | cut -f1)
    SIZE_FINAL=$(du -sh "$OUTPUT_FILE" | cut -f1)

    # Byte calculations for exact saved percentage
    if [[ "$OSTYPE" == "darwin"* ]]; then
        BYTES_ORIG=$(stat -f%z "$INPUT_PATH")
        BYTES_FINAL=$(stat -f%z "$OUTPUT_FILE")
    else
        BYTES_ORIG=$(du -sb "$INPUT_PATH" 2>/dev/null | cut -f1 || echo 0)
        BYTES_FINAL=$(stat -c%s "$OUTPUT_FILE" 2>/dev/null || echo 0)
    fi

    RATIO="0"
    if [[ $BYTES_ORIG -gt 0 ]]; then
        RATIO=$(awk "BEGIN {printf \"%.2f\", 100 - ($BYTES_FINAL / $BYTES_ORIG * 100)}")
    fi

    ok "Success!"
    echo "   File:     $OUTPUT_FILE"
    echo "   Original: $SIZE_ORIG"
    echo "   Packed:   $SIZE_FINAL"
    echo "   Saved:    ${RATIO}%"
else
    err "Compression failed."
    exit 1
fi
