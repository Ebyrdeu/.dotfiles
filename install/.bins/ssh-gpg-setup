#!/usr/bin/env bash
set -euo pipefail

# Colors
C_RESET='\033[0m'
C_OK='\033[0;32m'
C_WARN='\033[1;33m'
C_ERR='\033[0;31m'
C_HEAD='\033[1;36m'

# Helpers
say()  { printf "%b[INFO]%b %s\n" "$C_HEAD" "$C_RESET" "$*"; }
ok()   { printf "%b[OK]%b %s\n" "$C_OK"   "$C_RESET" "$*"; }
warn() { printf "%b[WARN]%b %s\n" "$C_WARN" "$C_RESET" "$*"; }
err()  { printf "%b[ERR]%b %s\n" "$C_ERR"  "$C_RESET" "$*" >&2; }

# Clipboard Helper
copy_to_clip() {
    local input_file="$1"
    local clip_cmd=""

    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] && command -v wl-copy >/dev/null 2>&1; then
        clip_cmd="wl-copy"
    elif command -v xclip >/dev/null 2>&1; then
        clip_cmd="xclip -selection clipboard"
    fi

    if [[ -n "$clip_cmd" ]]; then
        $clip_cmd < "$input_file"
        ok "Content copied to clipboard."
    else
        warn "No clipboard tool (wl-copy or xclip) found."
    fi
}

ensure_packages() {
    say "Checking system dependencies..."
    local deps=(openssh-clients gnupg2 pinentry git)

    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
        deps+=(wl-clipboard)
    else
        deps+=(xclip)
    fi

    local to_install=()
    for pkg in "${deps[@]}"; do
        rpm -q "$pkg" &>/dev/null || to_install+=("$pkg")
    done

    if [[ ${#to_install[@]} -gt 0 ]]; then
        say "Installing: ${to_install[*]}"
        sudo dnf install -y "${to_install[@]}"
        ok "Dependencies installed."
    else
        ok "All dependencies installed."
    fi
}

setup_ssh() {
    say "Starting SSH Setup..."
    local keyfile="$HOME/.ssh/id_ed25519"

    if [[ -f "$keyfile" ]]; then
        warn "SSH key already exists ($keyfile)."
    else
        read -rp "Enter email for SSH key comment: " email
        email=${email:-"$(whoami)@$(hostname)"}
        ssh-keygen -t ed25519 -C "$email" -f "$keyfile"
        ok "SSH key generated."
    fi

    if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
        eval "$(ssh-agent -s)"
    fi

    ssh-add "$keyfile" 2>/dev/null || warn "Key not added to agent."

    mkdir -p "$HOME/.ssh"
    touch "$HOME/.ssh/known_hosts"
    say "Scanning GitHub/GitLab host keys..."
    ssh-keyscan -H github.com gitlab.com 2>/dev/null >> "$HOME/.ssh/known_hosts" || true
    sort -u "$HOME/.ssh/known_hosts" -o "$HOME/.ssh/known_hosts"

    echo "------------------------------------------------------------"
    cat "$keyfile.pub"
    echo "------------------------------------------------------------"
    copy_to_clip "$keyfile.pub"
}

setup_gpg() {
    say "Starting GPG Setup..."

    if gpg --list-secret-keys --keyid-format LONG | grep -q "sec"; then
        warn "GPG keys already exist."
        read -rp "Generate a NEW key anyway? [y/N]: " ans
        if [[ ! "$ans" =~ ^[Yy]$ ]]; then return; fi
    fi

    gpg --full-generate-key

    local latest_key
    latest_key=$(gpg --list-secret-keys --with-colons | awk -F: '/^sec/ {print $5}' | tail -n1)

    if [[ -n "$latest_key" ]]; then
        say "Detected new key ID: $latest_key"
        read -rp "Export public key to clipboard? [Y/n]: " ans
        if [[ -z "${ans:-}" || "$ans" =~ ^[Yy]$ ]]; then
            local tmp_file
            tmp_file=$(mktemp)
            gpg --armor --export "$latest_key" > "$tmp_file"
            copy_to_clip "$tmp_file"
            rm -f "$tmp_file"
        fi
    fi
}

setup_git_gpg() {
    say "Configuring Git Global Settings..."

    export GPG_TTY=$(tty)
    if ! grep -qF "export GPG_TTY" "$HOME/.bashrc"; then
        echo 'export GPG_TTY=$(tty)' >> "$HOME/.bashrc"
        ok "Added GPG_TTY to .bashrc"
    fi

    local keys
    mapfile -t keys < <(gpg --list-secret-keys --with-colons | awk -F: '/^sec/ {print $5}')

    local keyid=""
    if [[ ${#keys[@]} -eq 0 ]]; then
        err "No GPG secret keys found. Run Setup GPG first."
        return
    elif [[ ${#keys[@]} -eq 1 ]]; then
        keyid="${keys[0]}"
        say "Found one GPG key: $keyid"
    else
        gpg --list-secret-keys --keyid-format LONG
        read -rp "Multiple keys found. Paste Key ID: " keyid
    fi

    if [[ -n "$keyid" ]]; then
        git config --global user.signingkey "$keyid"
        git config --global commit.gpgsign true
        git config --global gpg.program gpg
        ok "Git configured to sign with key: $keyid"
    fi
}

delete_ssh() {
    local keyfile="$HOME/.ssh/id_ed25519"
    [[ ! -f "$keyfile" ]] && { warn "No SSH key found."; return; }

    read -rp "DELETE SSH key ($keyfile)? [y/N]: " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        rm -f "$keyfile" "$keyfile.pub"
        ok "SSH key deleted."
    fi
}

delete_gpg() {
    gpg --list-secret-keys --keyid-format LONG
    read -rp "Enter Key ID to DELETE: " keyid
    [[ -z "$keyid" ]] && { warn "Cancelled."; return; }

    read -rp "Are you SURE? [y/N]: " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        gpg --delete-secret-keys "$keyid" 2>/dev/null || true
        gpg --delete-keys "$keyid" 2>/dev/null || true
        ok "GPG key deleted."
    fi
}

show_keys() {
    echo
    say "--- SSH Public Key ---"
    if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
        cat "$HOME/.ssh/id_ed25519.pub"
    else
        warn "No SSH public key found."
    fi

    echo
    say "--- GPG Keys & Armor Export ---"
    local gpg_keys
    mapfile -t gpg_keys < <(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^sec/ {print $5}')

    if [[ ${#gpg_keys[@]} -gt 0 ]]; then
        for key in "${gpg_keys[@]}"; do
            echo "Key ID: $key"
            echo "------------------------------------------------------------"
            gpg --armor --export "$key"
            echo "------------------------------------------------------------"
        done
    else
        warn "No GPG secret keys found."
    fi

    echo
    say "--- Git Configuration ---"
    echo "Signing Key: $(git config --global user.signingkey || echo 'Not Set')"
    echo "Auto Sign:   $(git config --global commit.gpgsign || echo 'Not Set')"
    echo
    read -rp "Press Enter to continue..."
}

# Main Execution Guard
if ! command -v dnf >/dev/null 2>&1; then
    err "This script requires Fedora (dnf)."
    exit 1
fi

while true; do
    echo
    printf "%bFedora SSH+GPG Manager%b\n" "$C_HEAD" "$C_RESET"
    echo "1) Setup SSH"
    echo "2) Setup GPG"
    echo "3) Setup BOTH (Recommended)"
    echo "4) Show Keys (SSH & GPG Armor Export)"
    echo "5) Link GPG to Git"
    echo "6) Delete SSH Key"
    echo "7) Delete GPG Key"
    echo "0) Exit"

    read -rp "Select option: " opt
    case $opt in
        1) ensure_packages; setup_ssh ;;
        2) ensure_packages; setup_gpg ;;
        3) ensure_packages; setup_ssh; setup_gpg; setup_git_gpg ;;
        4) show_keys ;;
        5) ensure_packages; setup_git_gpg ;;
        6) delete_ssh ;;
        7) delete_gpg ;;
        0) exit 0 ;;
        *) warn "Invalid option." ;;
    esac
done
