#!/usr/bin/env bash
set -euo pipefail

# Colors
C_RESET='\033[0m'
C_OK='\033[0;32m'
C_WARN='\033[1;33m'
C_ERR='\033[0;31m'
C_HEAD='\033[1;36m'

# Helpers
say()  { printf "%b[INFO]%b %s\n" "$C_HEAD" "$C_RESET" "$*"; }
ok()   { printf "%b[OK]%b %s\n" "$C_OK"   "$C_RESET" "$*"; }
warn() { printf "%b[WARN]%b %s\n" "$C_WARN" "$C_RESET" "$*"; }
err()  { printf "%b[ERR]%b %s\n" "$C_ERR"  "$C_RESET" "$*" >&2; }

# Usage Check
if [[ -z "${1:-}" ]]; then
    echo "Usage:   $(basename "$0") <file> [destination_folder]"
    echo "Example: $(basename "$0") archive.tar.gz"
    echo "Example: $(basename "$0") archive.tar.gz ./output_dir"
    exit 1
fi

FILE="$1"
DEST_DIR="${2:-}"

if [[ ! -f "$FILE" ]]; then
    err "File '$FILE' not found."
    exit 1
fi

# Prepare target directory array for tar
TAR_DEST=()
if [[ -n "$DEST_DIR" ]]; then
    mkdir -p "$DEST_DIR"
    TAR_DEST=(-C "$DEST_DIR")
    say "Extracting to: $DEST_DIR"
else
    say "Extracting to current directory..."
fi

# Multi-core & Progress Helper for Tar Archives
extract_tar() {
    local decompressor="$1" # e.g., pigz, pbzip2, zstd, xz

    # Check if a custom multi-core program exists
    if [[ -n "$decompressor" ]] && command -v "$decompressor" >/dev/null 2>&1; then
        say "Using $decompressor (multi-threaded optimization)"
        if command -v pv >/dev/null 2>&1; then
            pv "$FILE" | "$decompressor" -d | tar -xf - "${TAR_DEST[@]}"
        else
            "$decompressor" -d -c "$FILE" | tar -xf - "${TAR_DEST[@]}"
        fi
    # Fallback to standard pipe + PV progress bar
    elif command -v pv >/dev/null 2>&1; then
        pv "$FILE" | tar -xf - "${TAR_DEST[@]}"
    # Basic standard tar extraction
    else
        tar -xf "$FILE" "${TAR_DEST[@]}"
    fi
}

# Normalize filename to lowercase for robust extension matching
LOWER_FILE="${FILE,,}"

# ============================================================
# Extraction Logic
# ============================================================

if [[ "$LOWER_FILE" =~ \.(tar\.gz|tgz)$ ]]; then
    extract_tar "pigz"

elif [[ "$LOWER_FILE" =~ \.(tar\.bz2|tbz2)$ ]]; then
    extract_tar "pbzip2"

elif [[ "$LOWER_FILE" =~ \.(tar\.xz|txz)$ ]]; then
    extract_tar "pixz"

elif [[ "$LOWER_FILE" =~ \.(tar\.zst|tzst)$ ]]; then
    extract_tar "zstd"

elif [[ "$LOWER_FILE" == *.tar ]]; then
    extract_tar ""

elif [[ "$LOWER_FILE" == *.zip ]]; then
    command -v unzip >/dev/null 2>&1 || { err "Missing 'unzip'."; exit 1; }
    unzip "$FILE" ${DEST_DIR:+-d "$DEST_DIR"}

elif [[ "$LOWER_FILE" == *.7z ]]; then
    command -v 7z >/dev/null 2>&1 || { err "Missing '7z'."; exit 1; }
    7z x "$FILE" ${DEST_DIR:+"-o$DEST_DIR"}

elif [[ "$LOWER_FILE" == *.rar ]]; then
    command -v unrar >/dev/null 2>&1 || { err "Missing 'unrar'."; exit 1; }
    unrar x "$FILE" ${DEST_DIR:+"$DEST_DIR/"}

elif [[ "$LOWER_FILE" == *.zst ]]; then
    command -v zstd >/dev/null 2>&1 || { err "Missing 'zstd'."; exit 1; }
    zstd -d "$FILE" ${DEST_DIR:+-o "$DEST_DIR/$(basename "${FILE%.zst}")"}

elif [[ "$LOWER_FILE" == *.gz ]]; then
    if command -v pigz >/dev/null 2>&1; then
        pigz -d -k "$FILE"
    else
        gunzip -k "$FILE"
    fi

else
    err "Unknown format: $FILE"
    err "Supported formats: tar.gz, tar.bz2, tar.xz, tar.zst, zip, 7z, rar, zst, gz"
    exit 1
fi

ok "Done."
