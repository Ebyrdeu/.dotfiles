# ============================================================
# META / ENCODING SETTINGS (8-bit / UTF-8 Support)
# ============================================================
set meta-flag on
set input-meta on
set output-meta on
set convert-meta off

# ============================================================
# AUTOCOMPLETE & TAB COMPLETION BEHAVIOR
# ============================================================
# Case-insensitive tab completion
set completion-ignore-case on

# Show prefix indicator length when truncating common prefixes
set completion-prefix-display-length 2

# Immediately show completions on first Tab press without ringing bell
set show-all-if-ambiguous on
set show-all-if-unmodified on

# Append trailing slash to symlinked directories during completion
set mark-symlinked-directories on

# Do not autocomplete hidden files unless pattern explicitly begins with '.'
set match-hidden-files off

# Disable pagination — show all completions at once without 'more' prompt
set page-completions off

# Confirmation threshold for large completion lists
set completion-query-items 200

# File indicators (`ls -F` symbols) and colors in completion menu
set visible-stats on
set colored-stats on

# Intelligent completion around cursor position (Bash 4+)
set skip-completed-text on

# ============================================================
# KEY BINDINGS (Arrow Keys / History Search)
# ============================================================
# Match typed prefix against command history using Up/Down arrows
"\e[A": history-search-backward
"\e[B": history-search-forward
"\e[C": forward-char
"\e[D": backward-char
